# 复制成 .env 后填入自己的值。.env 已被 .gitignore 忽略，不要提交。
# 变量名兼容 OpenAI 标准：已有的 OPENAI_API_KEY 不用改也能用。
#
# DeepSeek（推荐，OpenAI 兼容，便宜）：
#   base_url = https://api.deepseek.com   （注意：不要加 /v1，代码会自己拼 /chat/completions）
#   model    = deepseek-flash
#   申请 key = https://platform.deepseek.com/api_keys

DA_LLM_BASE_URL=https://api.deepseek.com
DA_LLM_API_KEY=sk-replace-me
DA_LLM_MODEL=deepseek-flash

# DeepSeek 专用：思考模式默认是开的，工具调用场景建议关掉（更快更便宜）。
# 非 DeepSeek 的服务把这个注释掉，否则可能因为不认识该字段而报 400。
DA_LLM_THINKING=disabled

DA_LLM_TIMEOUT=120

# 多轮对话的上下文预算（tokens）。历史超过它就开始压缩。
# 调小更省钱，调大记得更久；4000 以下可能把有用的上下文压掉。
DA_CONTEXT_BUDGET=20000
